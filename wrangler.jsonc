
{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "little-explorers-ai-studio",
  "main": "./worker.js",
  "compatibility_date": "2026-11-23",
  "keep_vars": true,
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
